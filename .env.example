# Database: use Neon PostgreSQL in production.
DATABASE_URL=

# Flask/session security.
SCREENPLANT_SECRET_KEY=
SCREENPLANT_ADMIN_USER=admin
SCREENPLANT_ADMIN_PASSWORD=
SCREENPLANT_HTTPS=1

# Cloudflare R2 image/file storage.
SCREENPLANT_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional tuning.
SCREENPLANT_MAX_UPLOAD_MB=25
SCREENPLANT_TRASH_TTL_DAYS=7
SCREENPLANT_LOG_LEVEL=INFO

